# ==================================
# Pythonbot - Configuração de Ambiente
# ==================================
# Copie este arquivo para ~/.pythonbot/config/.env e preencha os valores.
# Ou execute: pythonbot setup

# LLM Provider (openrouter, openai, anthropic, ollama, lmstudio)
LLM_PROVIDER=openrouter

# API Key do provedor LLM
LLM_API_KEY=

# Modelo principal
LLM_MODEL=openai/gpt-4o-mini

# Base URL da API (deixe vazio para usar o default do provider)
LLM_BASE_URL=https://openrouter.ai/api/v1

# Modelo de visão (deixe vazio para usar o modelo principal)
VISION_MODEL=

# ==================================
# Telegram Bot
# ==================================
TELEGRAM_BOT_TOKEN=
# Lista de user IDs permitidos (separados por vírgula). Vazio = todos.
TELEGRAM_ALLOWED_USERS=

# ==================================
# Dashboard
# ==================================
API_HOST=127.0.0.1
API_PORT=8420
API_PASSWORD=pythonbot2026

# ==================================
# Features
# ==================================
ENABLE_VOICE=false
ENABLE_STT=false
DEBUG=false
